# CausalBot Environment Variables
# Copy this file to .env and fill in your values.
# Variables prefixed with VITE_ are exposed to the browser bundle.

# ─── LLM Provider ─────────────────────────────────────────────────────────────

# API key for the LLM provider (OpenAI, NVIDIA NIM, or any compatible endpoint)
VITE_LLM_API_KEY=your_api_key_here

# Base URL for the chat completions endpoint
# Default (if unset): proxied through Vite dev server at /api/nvidia/chat/completions
# Examples:
#   Gemini:     /api/gemini/chat/completions  (proxied via vite.config.js)
#   NVIDIA NIM: https://integrate.api.nvidia.com/v1
#   OpenAI:     https://api.openai.com/v1
VITE_LLM_API_URL=/api/gemini/chat/completions

# Model identifier to use for planning
# Examples:
#   Gemini:     gemini-2.5-flash
#   NVIDIA NIM: meta/llama-3.1-70b-instruct
#   OpenAI:     gpt-4o
VITE_LLM_MODEL=gemini-2.5-flash

# ─── RL Bridge ────────────────────────────────────────────────────────────────

# WebSocket URL for the Python RL training agent
# Default (if unset): ws://localhost:8765
# Only relevant when the app is launched with ?rl=true or ?mode=rl
VITE_RL_WS_URL=ws://localhost:8765

# ─── Developer Flags ──────────────────────────────────────────────────────────
# These are set as URL params at runtime, not environment variables:
#   ?debug=true   — enables extra console logging and debug overlay
#   ?rl=true      — connects RL bridge to Python agent on boot
#   ?mode=rl      — alias for ?rl=true
